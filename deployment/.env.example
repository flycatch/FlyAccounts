# FlyAccounts shared environment
# Copy to deployment/.env and adjust. Never commit deployment/.env.

POSTGRES_USER=flyaccounts
POSTGRES_PASSWORD=changeme
POSTGRES_DB=flyaccounts

# Backend (Compose service hostname: postgres)
DATABASE_URL=postgresql+psycopg://flyaccounts:changeme@postgres:5432/flyaccounts

# S3-compatible storage (Compose service hostname: minio)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=flyaccounts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:8080

# Browser-facing API prefix (not the Docker-internal hostname)
VITE_API_BASE_URL=http://localhost:8000/v1

BACKEND_PORT=8000
FRONTEND_PORT=8080

# Path to the committed OpenAPI document inside the backend container
OPENAPI_PATH=/app/contracts/openapi.yaml

# Microsoft Entra ID (organizational tenant only). Placeholders — never commit real values.
MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Organizational Microsoft work email of the first access-administration user
INITIAL_ADMIN_EMAIL=admin@example.com

# HMAC key for FlyAccounts access JWTs (use a long random string in deployment/.env)
JWT_SIGNING_KEY=change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Public frontend origin used in invitation email links (falls back to first CORS_ORIGINS entry)
FRONTEND_URL=http://localhost:8080

# SMTP for invitation email (placeholders — never commit real credentials)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
